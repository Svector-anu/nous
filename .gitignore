__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
data/*.db
data/*.db-journal
.DS_Store

# dev-only: playwright for scripts/verify_focus3d.mjs, never a project dependency
node_modules/
package-lock.json

# research media — raw video files, not project assets
*.mp4

# drop-in music loops. the score is synthesised, so these are optional and personal;
# whatever you put here is yours to license, not the repo's to carry.
src/viewer/beds/*
!src/viewer/beds/manifest.json

# design references and screenshots — pasted in to describe intent, not project assets.
# They are large, they date instantly, and none of them are read at runtime.
Screenshot*
*.jpg
*.jpeg
inspo.png
nav.png

# agent scratch: local tool config and any notes an agent writes for itself.
# Only AGENTS.md and CLAUDE.md are tracked docs; the rest drifts out of date.
.claude/
CHAIN_SHIP.md

# secrets: real keys live here, .env.example is the tracked template
.env
.env.*
!.env.example
