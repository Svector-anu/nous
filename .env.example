# Copy to .env and fill in. .env is gitignored; this template is not.
#
#     cp .env.example .env
#
# The sim runs fine with none of this set — every agent is a state machine and clan goals
# fall back to rules. These only matter when llm_enabled=True.

# --- dgrid (a gateway in front of many providers) ---------------------------
# IMPORTANT: this must be a *model* key (sk-...), not a management key (mk-...).
# A management key administers other keys and is allowed to list models, but it cannot
# call inference — it returns 401 from /v1/chat/completions while /v1/models still works,
# which looks like a broken request rather than the wrong kind of key.
# Create one in the DGrid console under "Model API Keys".
DGRID_API_KEY=sk-replace-me

# --- anthropic direct --------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-replace-me

# --- xai ---------------------------------------------------------------------
# XAI_API_KEY=replace-me

# --- openai, or anything openai-compatible (ollama, vllm, lm studio) ---------
# OPENAI_API_KEY=sk-replace-me
