# Copy to .env and fill in. .env is gitignored; this template is not.
#
#     cp .env.example .env
#
# The sim runs fine with none of this set — every agent is a state machine and clan goals
# fall back to rules. These only matter when llm_enabled=True.

# --- dgrid (a gateway in front of many providers) ---------------------------
# IMPORTANT: this must be a *model* key (sk-...), not a management key (mk-...).
# A management key administers other keys and is allowed to list models, but it cannot
# call inference — it returns 401 from /v1/chat/completions while /v1/models still works,
# which looks like a broken request rather than the wrong kind of key.
# Create one in the DGrid console under "Model API Keys".
DGRID_API_KEY=sk-replace-me

# --- anthropic direct --------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-replace-me

# --- xai ---------------------------------------------------------------------
# XAI_API_KEY=replace-me

# --- openai, or anything openai-compatible (ollama, vllm, lm studio) ---------
# OPENAI_API_KEY=sk-replace-me

# --- robinhood chain (wallet identity + x402 payment verification) -----------
# Optional: the sim runs without any of this. Prefers an Alchemy or Infura URL when set;
# falls back to the public rpc when not. Both mainnet and testnet are supported.
#
# ROBINHOOD_RPC_URL=https://robinhood-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE
# ROBINHOOD_TESTNET_RPC_URL=https://robinhood-testnet.g.alchemy.com/v2/YOUR_KEY_HERE
#
# The address that collects x402 payments. Required only when x402_verifier="chain" in
# config.py — the verifier checks that a transaction went to this address.
# X402_RECIPIENT_ADDRESS=0x…

# --- keeperhub (onchain receipts for clan decisions) -------------------------
# Optional and off by default, like llm_enabled: when False nothing here opens a socket,
# so an idle world still costs $0 and never appears on a chain explorer unasked.
# When True, a clan leader choosing to raid writes one transaction to a testnet as proof
# the decision happened — the world never reads from the chain and never waits on it.
# KEEPERHUB_ENABLED=true
# KEEPERHUB_API_KEY=kh_replace-me
#
# Where the proof transaction is sent. Pass a checksummed or an all-lowercase address —
# a mixed-case one whose EIP-55 checksum does not match is refused.
# KEEPERHUB_RECIPIENT=0x…
#
# Defaults to Base Sepolia (84532) and 0.000001. Override the chain only against
# GET /api/chains, where isEnabled and isTestnet must both be true.
# KEEPERHUB_CHAIN_ID=84532
# KEEPERHUB_AMOUNT=0.000001
